+++ b/fs/zeromount_readdir.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/fs.h>
+#include <linux/compat.h>
+#include <linux/sched.h>
+#include <linux/zeromount.h>
+
+/* Native filesystem cookies, including ext4 EOF, are never virtual state. */
+struct zeromount_dir_context {
+	struct dir_context ctx;
+	struct dir_context *target;
+	bool emitted;
+	bool full;
+};
+
+static bool zeromount_track_actor(struct dir_context *ctx, const char *name,
+				 int namlen, loff_t offset, u64 ino,
+				 unsigned int type)
+{
+	struct zeromount_dir_context *track =
+		container_of(ctx, struct zeromount_dir_context, ctx);
+	bool emitted;
+
+	track->target->pos = ctx->pos;
+	emitted = track->target->actor(track->target, name, namlen, offset, ino, type);
+	track->emitted |= emitted;
+	track->full |= !emitted;
+	return emitted;
+}
+
+static loff_t zeromount_cookie_base(loff_t cookie)
+{
+	return cookie >= ZEROMOUNT_MAGIC_POS ? ZEROMOUNT_MAGIC_POS : 0x70000000ULL;
+}
+
+static bool zeromount_virtual_pos(struct file *file, loff_t pos)
+{
+	loff_t last = file->f_zeromount_cookie;
+
+	return last && pos >= zeromount_cookie_base(last) && pos <= last;
+}
+
+static int zeromount_emit_children(struct file *file, struct dir_context *ctx)
+{
+	loff_t base = zeromount_cookie_base(file->f_zeromount_cookie);
+	unsigned long index = ctx->pos - base;
+	char name[NAME_MAX + 1];
+	unsigned long ino;
+	unsigned int type;
+
+	while (!signal_pending(current) &&
+	       zeromount_dir_child(file, index, name, &ino, &type)) {
+		/* The normal filldir actor preserves counts, d_off and fault errors. */
+		if (!dir_emit(ctx, name, strlen(name), ino, type))
+			break;
+		ctx->pos = base + ++index;
+		if (ctx->pos > file->f_zeromount_cookie)
+			file->f_zeromount_cookie = ctx->pos;
+	}
+	return 0;
+}
+
+int zeromount_iterate_dir(struct file *file, struct dir_context *ctx, bool shared)
+{
+	struct zeromount_dir_context track = {
+		.ctx.actor = zeromount_track_actor,
+		.ctx.pos = ctx->pos,
+		.target = ctx,
+	};
+	char name[NAME_MAX + 1];
+	unsigned long ino;
+	unsigned int type;
+	bool available = !zeromount_should_skip() &&
+		!zeromount_is_uid_blocked(current_uid().val);
+	int res;
+
+	if (zeromount_virtual_pos(file, ctx->pos)) {
+		if (available)
+			return zeromount_emit_children(file, ctx);
+		/* A disabled engine or hidden process must return to the real EOF. */
+		ctx->pos = file->f_zeromount_real_pos;
+		track.ctx.pos = ctx->pos;
+	}
+	file->f_zeromount_cookie = 0;
+	if (shared)
+		res = file->f_op->iterate_shared(file, &track.ctx);
+	else
+		res = file->f_op->iterate(file, &track.ctx);
+	ctx->pos = track.ctx.pos;
+
+	/* A separate EOF read ensures a short/full native read cannot lose entries. */
+	if (res < 0 || track.emitted || track.full || signal_pending(current) ||
+	    !available || !zeromount_dir_child(file, 0, name, &ino, &type))
+		return res;
+
+	file->f_zeromount_real_pos = ctx->pos;
+	ctx->pos = in_compat_syscall() ? 0x70000000ULL : ZEROMOUNT_MAGIC_POS;
+	file->f_zeromount_cookie = ctx->pos;
+	return zeromount_emit_children(file, ctx);
+}
+
+loff_t zeromount_dir_llseek(struct file *file, loff_t offset, int whence)
+{
+	loff_t result;
+
+	if (file->f_zeromount_cookie) {
+		if (whence == SEEK_CUR && !offset)
+			return file->f_pos;
+		if (whence == SEEK_SET && zeromount_virtual_pos(file, offset))
+			return vfs_setpos(file, offset, MAX_LFS_FILESIZE);
+	}
+	result = file->f_op->llseek(file, offset, whence);
+	if (result >= 0)
+		file->f_zeromount_cookie = 0;
+	return result;
+}
