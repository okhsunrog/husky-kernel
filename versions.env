# husky-kernel — pinned versions for a reproducible build.
#
# Every input is pinned here and nowhere else. A build reads this file, so the
# only way the output changes is by editing a line below. Target: Pixel 8 Pro
# (husky), GKI android14-6.1.

# ---- GKI kernel source (Google) ------------------------------------------
# Branch of android.googlesource.com/kernel/common. The device shipped with
# 6.1.157, security patch 2026-08; Google publishes monthly branches and no
# 2026-08 exists, so this tracks the nearest published month. Verified at sync.
GKI_BRANCH="android14-6.1-2026-09"

# ---- KernelSU-Next (root) ------------------------------------------------
# The manager the device already runs. pershoot's fork is what WildKernels
# ship; upstream is where our app-profile patch (patch A) was written and
# tested. They differ by a thin build pin, so we take upstream and pin it.
KSU_NEXT_REPO="https://github.com/KernelSU-Next/KernelSU-Next.git"
KSU_NEXT_REF="next"

# ---- SUSFS (hiding infrastructure) ---------------------------------------
# Same branch and commit the running kernel was built against.
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu.git"
SUSFS_BRANCH="gki-android14-6.1"
SUSFS_REV="4fc9c18"

# ---- ZeroMount (mount backend, replaces NoMount) -------------------------
# Kernel patches come vendored under patches/zeromount (from Super-Builders,
# by ZeroMount's own author); this pins the userspace module + WebUI.
ZEROMOUNT_REPO="https://github.com/Enginex0/zeromount.git"
ZEROMOUNT_REV="c3cb7ff"

# ---- vpnhide (built-in backend — the one we are here to test) ------------
# Built into the kernel, not loaded as an LKM. Manager APK is built from the
# same commit so the two never disagree. main, as requested.
VPNHIDE_REPO="https://github.com/okhsunrog/vpnhide.git"
VPNHIDE_REF="main"
VPNHIDE_REV="19e7903"

# ---- build ---------------------------------------------------------------
# android14-6.1 is kleaf; bazel is the path, thin LTO, AOSP prebuilt clang
# comes with `repo sync` (no system toolchain used for the kernel itself).
LTO_MODE="thin"
