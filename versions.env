# husky-kernel — pinned versions for a reproducible build.
#
# Every input is pinned here and nowhere else. A build reads this file, so the
# only way the output changes is by editing a line below. Target: Pixel 8 Pro
# (husky), GKI android14-6.1.

# ---- GKI kernel source (Google) ------------------------------------------
# Branch of android.googlesource.com/kernel/common. The device shipped with
# 6.1.157; the monthly branches (android14-6.1-YYYY-MM) turned out to be empty
# stubs at their tips, so we track the rolling LTS branch, which carries the
# real code (6.1.177 at pin time) and is the standard base for GKI builds.
GKI_BRANCH="android14-6.1-2025-12"

# ---- KernelSU-Next (root) ------------------------------------------------
# pershoot's dev-susfs branch. KernelSU-Next's kernel driver does NOT carry
# SUSFS -- only its manager UI is SUSFS-aware -- so upstream dev needs an
# adapted KSU-side SUSFS patch, and the one shipped for tiann/KernelSU rejects
# against the Next tree. pershoot maintains dev-susfs with SUSFS already
# integrated (config KSU_SUSFS and the hooks in-tree), which is what WildKernels
# build for the "next" flavor. Its dispatch.c matches upstream, so patch A
# applies unchanged.
KSU_NEXT_REPO="https://github.com/pershoot/KernelSU-Next.git"
KSU_NEXT_REF="dev-susfs"

# ---- SUSFS (hiding infrastructure) ---------------------------------------
# From simonpunk's susfs4ksu directly (maintained), the way WildKernels use it:
# copy its kernel_patches sources in, then apply its own 50_add_susfs patch. The
# patch is cut against a GKI without a couple of vendor-hook includes, so a small
# "fake patch" removes them first and a revert restores them -- see
# patches/susfs/. Same branch as the running kernel was built against.
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu.git"
SUSFS_BRANCH="gki-android14-6.1"

# ---- ZeroMount (mount backend, replaces NoMount) -------------------------
# Kernel patches come vendored under patches/zeromount (from Super-Builders,
# by ZeroMount's own author); this pins the userspace module + WebUI.
ZEROMOUNT_REPO="https://github.com/Enginex0/zeromount.git"
ZEROMOUNT_REV="c3cb7ff"

# ---- vpnhide (built-in backend — the one we are here to test) ------------
# Built into the kernel, not loaded as an LKM. Manager APK is built from the
# same commit so the two never disagree. main, as requested.
VPNHIDE_REPO="https://github.com/okhsunrog/vpnhide.git"
VPNHIDE_REF="main"
VPNHIDE_REV="19e7903"

# ---- build ---------------------------------------------------------------
# android14-6.1 is kleaf; bazel is the path, thin LTO, AOSP prebuilt clang
# comes with `repo sync` (no system toolchain used for the kernel itself).
LTO_MODE="thin"

# ---- stock scmversion (module vermagic tail) -----------------------------
# The device's prebuilt vendor modules (WiFi bcmdhd4398.ko, BT, ...) carry a
# vermagic string that MUST match the running kernel's UTS_RELEASE, or the
# kernel refuses to load them -- and AnyKernel3 flashes only Image, leaving
# those stock modules in place. kleaf builds the release as
# "-<android_release>-<KMI_GEN>" + scmversion; unstamped, scmversion is the
# placeholder "-maybe-dirty", which no stock module matches (dead WiFi/BT).
# build.sh pins the scmversion tail to this value so UTS_RELEASE reproduces the
# stock string exactly. Read it off the device's own module and update on an OTA:
#   strings /vendor/lib/modules/bcmdhd4398.ko | grep -m1 vermagic=
# For husky at security patch 2026-08 the tail is:
STOCK_SCMVERSION="-ge4470993d947-ab15260412"
