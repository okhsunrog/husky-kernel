# husky-kernel defconfig fragment.
#
# Turns on the subsystems the patch layers add. The kernel is built with
# check_defconfig disabled (see build.sh) so these merge into gki_defconfig
# without tripping validation. Values mirror what WildKernels enable for GKI.

# --- KernelSU-Next ---
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=n

# --- SUSFS (hiding) ---
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y

# --- ZeroMount (VFS redirect backend) ---
# CONFIG_ZEROMOUNT defaults to y in its Kconfig, so it is on without a line here;
# adding it would make savedefconfig (which drops defaults) mismatch gki_defconfig.

# --- vpnhide (built-in backend) ---
# The whole point of this build: vpnhide compiled in, not loaded as an LKM.
# CONFIG_VPNHIDE defaults to n, so it must be enabled here explicitly.
# FS_HIDING defaults to y once VPNHIDE is on; stated for intent.
CONFIG_VPNHIDE=y
CONFIG_VPNHIDE_FS_HIDING=y
